# Ruta a la base de datos SQLite del POS (modo read-only)
DATABASE_URL=file:../prisma/dev.db

# API Key de Google Gemini (Free Tier: https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Modelo Gemini a usar (configurable via GEMINI_MODEL env var)
# Default: gemini-3.1-flash-lite (500 RPD free tier)
# Opciones: gemini-2.5-flash (20 RPD), gemini-2.0-flash-lite, gemini-1.5-flash, etc.
GEMINI_MODEL=gemini-3.1-flash-lite

# Configuracion del Circuit Breaker
GEMINI_TIMEOUT_SECONDS=3.0
GEMINI_CIRCUIT_FAILURE_THRESHOLD=5
GEMINI_CIRCUIT_RECOVERY_SECONDS=60

# Modo del servicio
ENVIRONMENT=development

# CORS permitidos (separados por coma)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
