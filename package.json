{
  "name": "restaurant-system",
  "version": "1.0.1",
  "private": true,
  "scripts": {
    "setup:all": "node scripts/setup-system.js",
    "doctor": "node scripts/doctor.js",
    "dev": "cross-env NODE_ENV=development UV_THREADPOOL_SIZE=16 node --max-old-space-size=4096 server.js",
    "dev:next": "next dev --turbopack",
    "build": "next build",
    "build:optimized": "cross-env NODE_OPTIONS='--max-old-space-size=16384' next build",
    "start": "cross-env NODE_ENV=production node server.js",
    "start:next": "next start",
    "start:production": "cross-env NODE_ENV=production UV_THREADPOOL_SIZE=32 node --max-old-space-size=12288 server.js",
    "start:network": "cross-env NODE_ENV=production UV_THREADPOOL_SIZE=32 node --max-old-space-size=12288 server.js",
    "lint": "eslint .",
    "db:generate": "pnpm prisma generate",
    "db:push": "pnpm prisma db push",
    "db:seed": "pnpm tsx --env-file-if-exists=.env prisma/seed.ts",
    "db:setup": "pnpm prisma db push && pnpm db:seed",
    "db:backup": "powershell -ExecutionPolicy Bypass -File \"scripts/backup-db.ps1\"",
    "db:backup:usb": "powershell -ExecutionPolicy Bypass -File \"scripts/backup-db.ps1\" -DestinoExtra",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:load": "k6 run tests/load/carga.js",
    "test:stress": "k6 run tests/load/estres.js",
    "test:e2e:ui": "playwright test --ui",
    "test:setup": "node scripts/test-setup-all.js",
    "test:backup": "node scripts/test-backup-restore.js",
    "test:devops": "node scripts/test-devops-config.js",
    "verify": "pnpm tsc --noEmit && pnpm lint && pnpm test && pnpm build",
    "verify:full": "pnpm verify && pnpm ai:test && pnpm test:setup && pnpm test:backup && pnpm test:devops",
    "ai:setup": "node ai_engine/scripts/setup_env.js",
    "ai:generate": ".\\ai_engine\\venv\\Scripts\\python.exe -m ai_engine.scripts.generate_synthetic_data",
    "ai:start": ".\\ai_engine\\venv\\Scripts\\uvicorn.exe ai_engine.main:app --reload --host 127.0.0.1 --port 8000",
    "ai:test": ".\\ai_engine\\venv\\Scripts\\python.exe -m pytest ai_engine/tests",
    "dev:ai": "concurrently \"pnpm dev\" \"pnpm ai:start\"",
    "dev:ai:next": "concurrently \"pnpm dev:next\" \"pnpm ai:start\""
  },
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@react-email/components": "^1.0.12",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.526.0",
    "next": "^15.5.3",
    "next-auth": "^4.24.14",
    "next-pwa": "^5.6.0",
    "prisma": "^6.12.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-email": "^6.5.0",
    "react-hot-toast": "^2.5.2",
    "recharts": "^2.15.0",
    "resend": "^6.12.4",
    "serialport": "^12.0.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "swr": "^2.3.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.0.14"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "@serialport/bindings-cpp",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "serialize-javascript": ">=7.0.3",
      "postcss": ">=8.5.10",
      "uuid": ">=11.1.1",
      "ws": ">=8.20.1",
      "shell-quote": ">=1.8.4",
      "vite": ">=8.0.16",
      "js-yaml": ">=4.2.0",
      "esbuild": ">=0.28.1",
      "@babel/core": "^7.29.6"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@babel/core": "^7.29.6",
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "4.1.7",
    "concurrently": "^9.1.0",
    "cross-env": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.4.4",
    "prettier": "^3.8.3",
    "tailwindcss": "^4",
    "tsx": "^4.20.3",
    "tw-animate-css": "^1.3.6",
    "typescript": "^5",
    "vite": "^8.0.16",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.7"
  }
}
