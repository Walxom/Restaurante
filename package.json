{
  "name": "restaurant-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node server.js",
    "dev:next": "next dev --turbopack",
    "dev:optimized": "cross-env UV_THREADPOOL_SIZE=32 NODE_MAX_WORKERS=16 TURBOPACK=1 node --max-old-space-size=16384 server.js",
    "build": "next build",
    "build:optimized": "cross-env NODE_OPTIONS='--max-old-space-size=16384' next build",
    "start": "cross-env NODE_ENV=production node server.js",
    "start:next": "next start",
    "start:production": "cross-env NODE_ENV=production UV_THREADPOOL_SIZE=32 node --max-old-space-size=12288 server.js",
    "start:network": "cross-env NODE_ENV=production UV_THREADPOOL_SIZE=32 node --max-old-space-size=12288 server-production.js",
    "lint": "eslint .",
    "db:seed": "pnpm tsx --env-file=.env prisma/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.526.0",
    "next": "^15.5.3",
    "next-auth": "^4.24.14",
    "next-pwa": "^5.6.0",
    "prisma": "^6.12.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hot-toast": "^2.5.2",
    "restaurant-system": "link:",
    "serialport": "^12.0.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.0.14"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "postcss": "^8.5.1",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.4.4",
    "tailwindcss": "^4",
    "tsx": "^4.20.3",
    "tw-animate-css": "^1.3.6",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.7"
  }
}
