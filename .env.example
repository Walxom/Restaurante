# ==============================================================================
# SIGER-IA - Plantilla de Variables de Entorno (.env.example)
# Copie este archivo como '.env' en la raíz antes de ejecutar el sistema.
# ==============================================================================

# --- Base de Datos Prisma (SQLite Local-First) ---
DATABASE_URL="file:./dev.db"

# --- Servidor Web Next.js & Socket.IO ---
PORT=3001
NODE_ENV=development
NEXTAUTH_URL="http://localhost:3001"
NEXTAUTH_SECRET="siger_super_secret_jwt_key_2026_upn_trujillo"

# --- Motor de Inteligencia Artificial (Microservicio Python FastAPI) ---
# El puerto del motor se elige solo (desde AI_PORT, 8000 por defecto) y la web lo encuentra.
# AI_ENGINE_URL solo hace falta si el motor corre en otro equipo o contenedor (Docker lo define solo).
# AI_ENGINE_URL="http://otro-equipo:8000"
AI_ENGINE_ENABLED=true

# --- Google Gemini AI (LLM Conversacional & Narrativas Inteligentes) ---
# Obtén tu clave gratuita en: https://aistudio.google.com/apikey
# Si no se define aquí, el Administrador (JEFE) puede configurarla directamente desde /dashboard/inteligencia
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.1-flash-lite"

# --- Red de Impresión Térmica ESC/POS ---
PRINTER_SERVICE_ENABLED=false
DEFAULT_KITCHEN_PRINTER_IP="192.168.0.100"
DEFAULT_PRINTER_PORT=9100

# --- WebSockets en Tiempo Real ---
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"
