# ==============================================================================
# SIGER-IA — variables para Docker Compose
# Copie este archivo como ".env" (en la misma carpeta que docker-compose.yml).
# ==============================================================================

# OBLIGATORIO. Clave para firmar las sesiones (mínimo 32 caracteres aleatorios).
#   Linux / macOS:  openssl rand -base64 32
#   Windows (PowerShell):
#     [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
NEXTAUTH_SECRET=

# Dirección con la que las tablets y PCs del local abren el sistema.
# Use la IP fija del servidor en la red, por ejemplo http://192.168.1.50:3001
NEXTAUTH_URL=http://localhost:3001

# Puerto publicado en el servidor (por defecto 3001)
WEB_PORT=3001

# Opcional: chat con Google Gemini. Sin clave, la IA funciona con reglas locales.
GEMINI_API_KEY=

# Opcional
RESTAURANT_NAME=Fondo Marino
TZ=America/Lima
