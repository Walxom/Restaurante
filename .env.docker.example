# ==============================================================================
# SIGER-IA — ajustes OPCIONALES para Docker Compose
# El sistema arranca sin este archivo. Para cambiar algo, cópielo como ".env"
# (en la misma carpeta que docker-compose.yml) y edite solo lo que necesite.
# ==============================================================================

# Puerto publicado en el servidor (por defecto 3001)
WEB_PORT=3001

# Chat con Google Gemini. Sin clave, la IA funciona con reglas locales.
# También se puede configurar después desde Dashboard > Inteligencia.
GEMINI_API_KEY=

# Nombre del restaurante en los textos del motor de IA y zona horaria
RESTAURANT_NAME=Fondo Marino
TZ=America/Lima

# Clave de sesiones. Déjela vacía: el contenedor genera una segura y la guarda en
# el volumen de datos. Defínala solo si necesita fijarla (mínimo 32 caracteres).
SIGER_SECRET=
